	column '% QC Score'
		dataType: double
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c4082c81-99f1-47f1-b4c6-f91ce7702077
		summarizeBy: sum
		sourceColumn: % QC Score

		annotation SummarizationSetBy = Automatic

	column 'PeriodoNH QC' = ```
			
			VAR Agente = 'Base QA'[Reviewed Agent Email]
			VAR DataAtendimento = 'Base QA'[Date QC]
			
			VAR DataInicioNesting =
			    CALCULATE(
			        MAX('BASE NH'[Inicio Nesting]),
			        FILTER('BASE NH', 'BASE NH'[User Email] = Agente)
			    )
			
			VAR DataGoLive =
			    CALCULATE(
			        MAX('BASE NH'[GO LIVE]),
			        FILTER('BASE NH', 'BASE NH'[User Email] = Agente)
			    )
			
			VAR DiasPosGoLive =
			    IF(
			        NOT ISBLANK(DataGoLive),
			        DATEDIFF(DataGoLive, DataAtendimento, DAY)
			    )
			
			RETURN
			    IF(
			        ISBLANK(DataGoLive),
			        BLANK(),  -- Se o agente não estiver na base NH, retorna em branco
			        SWITCH(
			            TRUE(),
			            DataAtendimento >= DataInicioNesting && DataAtendimento < DataGoLive, "Nesting",
			            DiasPosGoLive <= 30, "30",
			            DiasPosGoLive <= 60, "60",
			            DiasPosGoLive <= 90, "90",
			            "90+"
			        )
			    )
			
			```
		dataType: string
		lineageTag: edf15424-b832-416e-b375-b088ccc5d4d1
		summarizeBy: none

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

	column Case
		dataType: int64
		formatString: 0
		lineageTag: 54f12381-a2f0-4de4-bf56-70d71688dace
		summarizeBy: none
		sourceColumn: Case

		annotation SummarizationSetBy = Automatic

	column 'OrdemPeriodoNH QC' =
			
			SWITCH(
			    'Base QA'[PeriodoNH QC],
			    "Nesting", 0,
			    "30", 1,
			    "60", 2,
			    "90", 3,
			    "90+", 4,
			    "", 99
			)
		formatString: 0
		lineageTag: 378ae428-d5e9-415a-be81-32969f0e01df
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition 'Base QA' = m
		mode: import
		source =
				// Base fictícia gerada para portfólio: mesmo formato das curvas da operação, outros números.
				// Nomes e e-mails já chegam fictícios; nenhum dado real passa por esta consulta.
				let
				    Fonte = Csv.Document(File.Contents(Caminho_Base & "\QA.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Cabeçalhos Promovidos" = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(#"Cabeçalhos Promovidos", {{"Created Date/Time", type datetime}, {"Case Owner Role", type text}, {"QC Assessment: QC Assessment Name", type text}, {"QC Score", Int64.Type}, {"Date QC", type date}, {"% QC Score", type number}, {"Case", Int64.Type}, {"Reviewed Agent", type text}, {"Reviewed Agent Email", type text}, {"Manager (current)", type text}}, "en-US")
				in
				    #"Tipo Alterado"

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

