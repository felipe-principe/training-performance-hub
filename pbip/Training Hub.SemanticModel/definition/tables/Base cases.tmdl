table 'Base cases'
	lineageTag: cb4437f3-ff62-4576-afbd-e4cba265984d

	/// PE (CSAT) - Share of survey respondents who rated their experience 4 or 5 (Promoters), out of all completed CSAT surveys.
	measure PE = (CALCULATE(COUNT('Base cases'[Experience Score]),'Base cases'[Experience Score]>=4))/(CALCULATE(COUNT('Base cases'[Experience Score]),'Base cases'[Experience Score]<>BLANK()))
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 01 CSAT
		lineageTag: 583ee8f4-c960-47ec-bebf-d9b6a9b6696c

	/// IR (CSAT Resolution) - Share of survey respondents who reported their issue was resolved, out of all completed CSAT surveys.
	measure IR = (CALCULATE(COUNT('Base cases'[Resolved?]),'Base cases'[Resolved?]="yes"))/(CALCULATE(COUNT('Base cases'[Resolved?]),'Base cases'[Resolved?]<>BLANK()))
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 01 CSAT
		lineageTag: dba5e60e-a687-40da-9aae-ff801b7efb10

	measure 'Qtd. Detractor PE' = CALCULATE(COUNT('Base cases'[Experience Score]),'Base cases'[Experience Score]<=3)
		formatString: 0
		displayFolder: 05 Auxiliares
		lineageTag: 90ae73db-1b9a-47ac-a86a-362c7060c4ef

	measure 'Qtd. PE' = CALCULATE(COUNT('Base cases'[Experience Score]),'Base cases'[Experience Score]>=4)
		formatString: 0
		displayFolder: 05 Auxiliares
		lineageTag: fa3399b1-a1e9-4fe3-a8ea-1f652140e895

	/// Total Cases - Total number of customer service cases handled in the selected period.
	measure 'Total Cases' = COUNT('Base cases'[Case Number])
		formatString: 0
		displayFolder: 03 Volume e AHT
		lineageTag: 49fbdb69-cd80-448c-9b92-0af1fd0481b0

	/// Total Survey - Total number of completed CSAT survey responses.
	measure 'Total Survey' = COUNT('Base cases'[Survey#])
		formatString: 0
		displayFolder: 01 CSAT
		lineageTag: 9ff8c370-2676-405f-ab45-cbbfd83d6b32

	measure 'Qtd. IR' = CALCULATE(COUNT('Base cases'[Resolved?]),'Base cases'[Resolved?]="yes")
		formatString: 0
		displayFolder: 05 Auxiliares
		lineageTag: 45a70349-efe1-403e-a696-da2b9d134a9c

	measure 'Qtd. Detractor IR' = CALCULATE(COUNT('Base cases'[Resolved?]),'Base cases'[Resolved?]="No")
		formatString: 0
		displayFolder: 05 Auxiliares
		lineageTag: 037aca6a-61cc-41e6-b666-90acfd33a040

	/// RR (Response Rate) - Share of cases with a completed CSAT survey, out of all cases handled.
	measure RR = [Total Survey]/[Total Cases]
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01 CSAT
		lineageTag: f1bfefb3-1086-4adb-b3ee-c3de8e9759a9

	/// PE Deviation - Difference between actual PE and the 95% target.
	measure 'PE Deviation' = [PE]-0.95
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 01 CSAT
		lineageTag: 8470acfa-327a-41f2-b161-f684d640b82c

	/// IR Deviation - Difference between actual IR and the 89% target.
	measure 'IR Deviation' = [IR]-0.89
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 01 CSAT
		lineageTag: e5a1a2f4-9d71-47a5-abb7-bb8f484fae16

	/// AHT (Average Handle Time) - Median chat handle time per case, in seconds.
	measure AHT = MEDIAN('Base cases'[Total Chat Handle Time])
		formatString: 0
		displayFolder: 03 Volume e AHT
		lineageTag: cbc5926f-9b8c-42fc-9674-4c6b25672f1d

	measure 'PE Auxiliar' = 1-[PE]
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 05 Auxiliares
		lineageTag: 96f40987-b960-4884-850a-e7b025be0dfc

	measure 'IR Auxiliar' = 1 - [IR]
		displayFolder: 05 Auxiliares
		lineageTag: 4fa9055f-18fb-4c70-8342-99af47bc7373

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Total Chat - Total number of chat channel cases.
	measure 'Total Chat' = CALCULATE(COUNT('Base cases'[Case Number]),'Base cases'[Case Record Type]="Chat - Streaming")
		formatString: 0
		displayFolder: 03 Volume e AHT
		lineageTag: fc2fb0a9-6acd-4baf-a3c7-4feb325102bf

	/// Total Phone - Total number of phone channel cases.
	measure 'Total Phone' = CALCULATE(COUNT('Base cases'[Case Number]),'Base cases'[Case Record Type]="Inbound Phone - Streaming")
		formatString: 0
		displayFolder: 03 Volume e AHT
		lineageTag: 81b645bc-03f8-4a95-942d-163f9ecb99d1

	/// QC Score - Average Quality Compliance score across evaluated interactions, on a 0-100 point scale.
	measure 'QC Score' = SUM('Base QA'[QC Score])/[Total QC]
		formatString: 0
		displayFolder: 02 Qualidade
		lineageTag: 46406fcd-18a7-4bb4-9728-0141f4125601

	/// QC Deviation - Difference between actual QC Score and the 95-point target.
	measure 'QC Deviation' = [QC Score]-95
		displayFolder: 02 Qualidade
		lineageTag: 2568029f-2390-40cb-903d-8ef60bdf8fdc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// QC (%) - Average Quality Compliance score across evaluated interactions, expressed as a percentage.
	measure %QC = SUM('Base QA'[% QC Score])/[Total QC]
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 02 Qualidade
		lineageTag: 0afb7a97-b758-42f4-a04e-01eabf9bd5ab

	measure 'QC Auxiliar' = 1-[%QC]
		displayFolder: 05 Auxiliares
		lineageTag: 09af4b66-14eb-4cbd-ac91-93745719060c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

