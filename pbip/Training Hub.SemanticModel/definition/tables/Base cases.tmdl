	column PeriodoNH =
			
			
			VAR Agente = 'Base cases'[Case Owner Email]
			VAR DataAtendimento = 'Base cases'[Date]
			
			VAR DataInicioNesting =
			    CALCULATE(
			        MAX('BASE NH'[Inicio Nesting]),
			        FILTER('BASE NH', 'BASE NH'[User Email] = Agente)
			    )
			
			VAR DataGoLive =
			    CALCULATE(
			        MAX('BASE NH'[GO LIVE]),
			        FILTER('BASE NH', 'BASE NH'[User Email] = Agente)
			    )
			
			VAR DiasPosGoLive =
			    IF(
			        NOT ISBLANK(DataGoLive),
			        DATEDIFF(DataGoLive, DataAtendimento, DAY)
			    )
			
			RETURN
			        IF(
			            ISBLANK(DataGoLive),
			            BLANK(),  -- Se o agente não estiver na base NH, retorna em branco
			            SWITCH(
			                TRUE(),
			                DataAtendimento >= DataInicioNesting && DataAtendimento < DataGoLive, "Nesting",
			                DiasPosGoLive <= 30, "30",
			                DiasPosGoLive <= 60, "60",
			                DiasPosGoLive <= 90, "90",
			                "90+"
			))
		lineageTag: 58bc50e4-c3fd-4344-85a3-a6852dbef489
		summarizeBy: none
		sortByColumn: OrdemPeriodoNH

		annotation SummarizationSetBy = Automatic

	column OrdemPeriodoNH =
			
			VAR Agente = 'Base cases'[Case Owner Email]
			VAR DataAtendimento = 'Base cases'[Date]
			
			VAR DataInicioNesting =
			    CALCULATE(
			        MAX('BASE NH'[Inicio Nesting]),
			        FILTER('BASE NH', 'BASE NH'[User Email] = Agente)
			    )
			
			VAR DataGoLive =
			    CALCULATE(
			        MAX('BASE NH'[GO LIVE]),
			        FILTER('BASE NH', 'BASE NH'[User Email] = Agente)
			    )
			
			VAR DiasPosGoLive =
			    IF(
			        NOT ISBLANK(DataGoLive),
			        DATEDIFF(DataGoLive, DataAtendimento, DAY)
			    )
			
			RETURN
			    IF(
			        ISBLANK(DataGoLive),
			        BLANK(),
			        SWITCH(
			            TRUE(),
			            DataAtendimento >= DataInicioNesting && DataAtendimento < DataGoLive, 0,
			            DiasPosGoLive <= 30, 1,
			            DiasPosGoLive <= 60, 2,
			            DiasPosGoLive <= 90, 3,
			            4
			        )
			    )
		formatString: 0
		lineageTag: e4daebbb-ddd2-40c4-a5c9-ab663163a6d4
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'PE NH Target' =
			SWITCH(
			    TRUE(),
			    'Base cases'[PeriodoNH]="Nesting",0.9,
			    'Base cases'[PeriodoNH]="30",0.92,
			    'Base cases'[PeriodoNH]="60",0.935,
			    'Base cases'[PeriodoNH]="90",0.95,
			    'Base cases'[PeriodoNH]="90+",0.95,
			    BLANK()
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 3af8cd79-3064-4cae-a24b-3ef2ba7f8dfa
